{
	"name": "k6-starter-kit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "22.16.0",
		"npm": "10.9.2"
	},
	"packageManager": "npm@10.9.2",
	"scripts": {
		"format": "prettier --write \"examples/**/*.ts\" \"scripts/**/*.mjs\"",
		"format:check": "prettier --check \"examples/**/*.ts\" \"scripts/**/*.mjs\"",
		"typecheck": "tsc --noEmit",
		"runtime:check": "node scripts/check-runtime.mjs",
		"smoke:toolchain": "npm run runtime:check && k6 run examples/toolchain/smoke.ts",
		"lint": "npm run typecheck && node --check scripts/check-runtime.mjs",
		"test": "node --test scripts/check-runtime.test.mjs tests/integration/fixture.test.mjs",
		"fixture": "node fixtures/server.mjs",
		"test:fixture": "node --test tests/integration/fixture.test.mjs"
	},
	"devDependencies": {
		"@types/k6": "0.57.1",
		"prettier": "3.5.3",
		"typescript": "5.8.3"
	}
}
